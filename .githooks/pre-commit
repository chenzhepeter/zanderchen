#!/bin/bash
# pre-commit: 自动把各游戏的 APP_VERSION 更新为 YYYY.M.D.N
#   N = (北京时间当天已存在的 commit 数 + 1)
# 仅更新本次 commit 实际改动到的项目（按目录前缀判断），避免无关 commit 触发 bump。

set -e

# 北京时间日期 + 当天起始时刻
BJ_DATE=$(TZ='Asia/Shanghai' date +'%Y.%-m.%-d')
BJ_DAY_START="$(TZ='Asia/Shanghai' date +'%Y-%m-%d') 00:00:00 +0800"

# 当天已有 commit 数 → 本次序号
COUNT=$(git log --since="$BJ_DAY_START" --oneline 2>/dev/null | wc -l | tr -d ' ')
NEW_VERSION="${BJ_DATE}.$((COUNT + 1))"

# bump <目录前缀> <含 APP_VERSION 的文件>
bump() {
  local dir="$1" file="$2"
  [ -f "$file" ] || return 0
  # 仅当本次 commit 涉及该目录时才更新
  git diff --cached --name-only | grep -q "^${dir}/" || return 0
  local current
  current=$(grep "export const APP_VERSION" "$file" | sed "s/.*'\([^']*\)'.*/\1/")
  if [ "$current" != "$NEW_VERSION" ]; then
    # macOS BSD sed 与 GNU sed 都接受此 -i.bak 形式
    sed -i.bak "s/export const APP_VERSION = '[^']*'/export const APP_VERSION = '$NEW_VERSION'/" "$file"
    rm -f "${file}.bak"
    git add "$file"
    echo "[pre-commit] ${dir} APP_VERSION: $current → $NEW_VERSION"
  fi
}

bump "airline" "airline/js/state.js"
bump "towerclash" "towerclash/js/data/config.js"

exit 0
